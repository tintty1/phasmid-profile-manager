# Phasmid Profile Manager — configuration template.
# Copy to .env and edit. All variables use the PPM_ prefix.

# API server
PPM_HOST=127.0.0.1
PPM_PORT=8000

# Comma-separated allowed CORS origins (the frontend dev server)
PPM_CORS_ORIGINS=http://localhost:3000

# Optional API key for machine clients. Leave empty to disable (local-only use).
# Human login is separate: create an account with `phasmid-pm user add <name>`.
PPM_API_KEY=

# Login session lifetime in hours (default 168 = one week).
PPM_SESSION_TTL_HOURS=168

# Force the Secure flag on the session cookie. Set to 1 behind a
# TLS-terminating reverse proxy, where the app itself sees plain HTTP.
PPM_SECURE_COOKIES=0

# SQLite database path
PPM_DB_PATH=data/profiles.db

# Seconds a profile's lease survives without a heartbeat — how long an instance
# that died keeps its profiles locked against the others. Minimum 60; the
# heartbeat renews every 30s, so anything shorter expires leases under live
# browsers.
PPM_LEASE_TTL=120

# Override where the bundled web UI is served from. Leave empty to use the
# package's own webui/ directory, then web/out when running from source.
PPM_WEBUI_DIR=

# Encryption key for proxy credentials at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PPM_SECRET_KEY=
